# API Keys for LLM / Summarization (at least one is recommended, or enter directly in UI)
# You can provide a single key or multiple keys separated by commas for multi-account parallel speedup!
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=key_account1_here,key_account2_here,key_account3_here,key_account4_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here


# Whisper settings (default: tiny or base for fast CPU inference)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Default Summary settings
DEFAULT_SUMMARY_RATIO=0.30
